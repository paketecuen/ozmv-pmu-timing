+  // VARIANT: the least-squares fit restricted to some columns, from the same weighted sums.
+  template <unsigned N> static bool SolveSub(const unsigned (&cols)[N], const Fit &fit, double (&answer)[N][7]) {
+    double a[N][N + 7], scale[N];
+    for(unsigned i = 0; i < N; ++i) scale[i] = std::sqrt(fit.Gram[cols[i]][cols[i]]);
+    for(unsigned i = 0; i < N; ++i) {
+      for(unsigned j = 0; j < N; ++j) a[i][j] = fit.Gram[cols[i]][cols[j]] / scale[i] / scale[j];
+      for(unsigned c = 0; c < 7; ++c) a[i][N + c] = fit.Rhs[cols[i]][c] / scale[i];
+    }
+    for(unsigned col = 0; col < N; ++col) {
+      unsigned p = col;
+      for(unsigned r = col + 1; r < N; ++r) if(std::abs(a[r][col]) > std::abs(a[p][col])) p = r;
+      if(std::abs(a[p][col]) < 1e-12) return false;
+      for(unsigned j = 0; j < N + 7; ++j) std::swap(a[col][j], a[p][j]);
+      const double d = a[col][col];
+      for(unsigned j = 0; j < N + 7; ++j) a[col][j] /= d;
+      for(unsigned r = 0; r < N; ++r) if(r != col) {
+        const double f = a[r][col];
+        for(unsigned j = 0; j < N + 7; ++j) a[r][j] -= f * a[col][j];
+      }
     }
+    for(unsigned i = 0; i < N; ++i) for(unsigned c = 0; c < 7; ++c) answer[i][c] = a[i][N + c] / scale[i] * fit.Peaks[c];
     return true;
   }
 
